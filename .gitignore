# ambiente Python
.venv/
venv/
__pycache__/
*.py[cod]

# SEGREDOS: chaves do Azure ficam só no .env local
.env

# dados: data/ guarda só as amostras de exemplo versionadas;
# dados adicionados localmente (bases completas, vídeos, áudios) não vão para o Git
data/speech/
data/exercise_videos/Ex*/
data/physio_videos/*
!data/physio_videos/*_example.mp4
data/consultations/*.wav
data/motion_capture/*
!data/motion_capture/S01/
datasets/
example_data/
sample_datasets/
*.zip
*.part

# modelos baixados/treinados
models/*
!models/.gitkeep
*.joblib
*.pt
*.caffemodel

# saídas geradas pelo pipeline
results/*
!results/.gitkeep

# sistema
.DS_Store
Thumbs.db
