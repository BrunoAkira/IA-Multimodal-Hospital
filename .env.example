# Copie para ".env" e preencha. NUNCA envie o .env para o Git.
# Crie os recursos no portal do Azure escolhendo o tipo de preço "Free F0".

# Azure AI Speech (Speech to Text) — F0: 5 h de áudio/mês
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure AI Language (Text Analytics: sentimento + Text Analytics for health) — F0: 5 000 registros/mês
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com

# Limites de segurança (abaixo do gratuito)
SPEECH_SECONDS_BUDGET=14400
LANGUAGE_RECORDS_BUDGET=4000
AZURE_STT_TORGO_SAMPLES=60
MAX_TORGO_ROWS=1500
